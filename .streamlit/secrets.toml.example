# Copy to .streamlit/secrets.toml for a local rehearsal of the hosted build, or paste
# the same contents into Streamlit Community Cloud under
# "App settings -> Secrets". secrets.toml is gitignored; this example is not.
#
# The names are identical to the ones in .env - src/config.py reads st.secrets when
# hosted and .env locally, so no code branches on where a value came from.

# Required: the site keeps no state on disk.
DATABASE_URL = "postgresql://user:password@host:5432/monsoon?sslmode=require"

# Required: switches to the committed models in app/assets/models/, runs the forecast
# in-process to stay inside ~2.7 GB, and hides the Chronos-2 controls.
HOSTED_MODE = "true"

# Admin login for the seeded account. Without it, db.init generates one and prints it.
ADMIN_PASSWORD = "change-me"

# Optional language layer. Absent means template text only, which is fully working.
SARVAM_API_KEY = ""
GEMINI_API_KEY = ""

# Optional WhatsApp delivery. Absent means messages are written to the database with
# channel="mock" and Twilio is never called.
TWILIO_ACCOUNT_SID = ""
TWILIO_AUTH_TOKEN = ""
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

# Force every service into mock mode regardless of the keys above.
MOCK_MODE = "false"

# Sections work too: src/config.py flattens [twilio] account_sid into
# TWILIO_ACCOUNT_SID, so Streamlit Cloud's suggested layout is also accepted.
# [twilio]
# account_sid = "..."
# auth_token = "..."
