# Copy to .env and fill in. .env is git-ignored and must never be committed or printed.

# --- Copernicus CDS (ERA5 / seasonal forecasts) -------------------------------
# Get from https://cds.climate.copernicus.eu/profile  (also write ~/.cdsapirc)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Twilio WhatsApp sandbox --------------------------------------------------
# https://console.twilio.com  -> Messaging -> Try it out -> WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated sandbox-joined test recipients, e.g. whatsapp:+9199XXXXXXXX
TWILIO_WHATSAPP_TEST_TO=

# --- Language layer (config/llm.yaml) ----------------------------------------
# Sarvam AI: translate + chat. https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional ----------------------------------------------------------------
# IMD data root override; defaults to data/raw/imd
IMD_DATA_DIR=

# --- Database ----------------------------------------------------------------
# Empty -> SQLite at data/monsoon.db. Set to a Postgres URL for a deployment;
# a provider-supplied "postgres://" scheme is normalised automatically.
DATABASE_URL=
# The cloud target for `python -m src.db.migrate_to_postgres --target-env
# DATABASE_URL_CLOUD`. Kept separate from DATABASE_URL so a local run never
# writes to the deployed database by accident.
DATABASE_URL_CLOUD=

# --- Model artifacts (Hugging Face Spaces) -----------------------------------
# Private model repo holding models/lgbm/ and data/processed/train_table.parquet.
# Published by scripts/upload_models.py, fetched at startup by src/artifacts.py.
HF_MODEL_REPO=
# Read scope is enough for the Space; uploading needs a write token.
HF_TOKEN=

# --- Control panel -----------------------------------------------------------
# The admin account `python -m src.db.init` seeds. Both are optional: the username
# defaults to "admin" and the password is generated and printed once if unset.
# scripts/manage_users.py changes either on a live database without reseeding.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# The evaluator demo account (role "demo", config/demo.yaml). Shown on the sign-in page
# and used by `python -m src.jobs.demo_reset` (nightly, .github/workflows/demo-reset.yml)
# to create the account; login still checks the bcrypt hash in the users table. Set the
# same two names in Streamlit secrets and in the GitHub Actions secrets.
DEMO_USERNAME=
DEMO_PASSWORD=
# true -> the app behaves as the deployed website: models come from
# app/assets/models/, the forecast runs in-process, and Chronos-2 is hidden.
# Set it locally to rehearse the hosted build (see README).
HOSTED_MODE=
# true -> every service is mocked regardless of which keys are present.
MOCK_MODE=
# true -> allow Chronos-2 in the online forecast path. Off by default; see the
# "Chronos-2 on CPU" section of README.md before turning it on.
ENABLE_CHRONOS=

# --- Not read by any code yet ------------------------------------------------
# Present in .env; listed here so the two files stay in sync (CLAUDE.md §11).
# A single WhatsApp/Telegram number for live demos.
DEMO_PHONE=
# For a future Telegram delivery channel; src/sender.py only speaks Twilio today.
TELEGRAM_BOT_TOKEN=
