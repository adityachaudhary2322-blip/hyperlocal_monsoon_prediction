# Copy to .env and fill in. .env is git-ignored and must never be committed or printed.

# --- Copernicus CDS (ERA5 / seasonal forecasts) -------------------------------
# Get from https://cds.climate.copernicus.eu/profile  (also write ~/.cdsapirc)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Twilio WhatsApp sandbox --------------------------------------------------
# https://console.twilio.com  -> Messaging -> Try it out -> WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated sandbox-joined test recipients, e.g. whatsapp:+9199XXXXXXXX
TWILIO_WHATSAPP_TEST_TO=

# --- Optional ----------------------------------------------------------------
# IMD data root override; defaults to data/raw/imd
IMD_DATA_DIR=
